# Google Cloud & Vertex AI Runtime Configuration (No raw API keys!)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Strategic Model Routing Tiers
C4_FAST_MODEL=gemini-2.5-flash
C4_REASONING_MODEL=gemini-2.5-pro

# Secret Manager Secret IDs (resolved at runtime via IAM / ADC, never hardcoded)
C4_MODEL_ARMOR_TEMPLATE_SECRET_ID=c4-architect-model-armor-template
C4_PUBLISHING_WEBHOOK_SECRET_ID=c4-architect-publishing-webhook-token
C4_DB_CONN_SECRET_ID=c4-architect-session-db-uri

# Persistent Session & Knowledge Store Configuration
C4_SESSION_DB_URL=sqlite+aiosqlite:///./data/c4_sessions.db
C4_KNOWLEDGE_DB_PATH=./data/c4_knowledge_store.sqlite3
C4_VERTEX_SEARCH_DATASTORE_ID=

# Observability & Privacy Controls
C4_SERVICE_NAME=c4-architect-agent
C4_ENVIRONMENT=development
C4_ENABLE_CLOUD_TRACE=FALSE
C4_ENABLE_CLOUD_DLP=FALSE
C4_LOG_LEVEL=INFO
